{
  "name": "ordenia-docker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "check": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "data:import": "node --env-file-if-exists=.env scripts/import-sites.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:respaldo": "bats tests/backup_restore.bats"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "drizzle-orm": "0.45.2",
    "pg": "^8.16.3",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.57.4"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@tailwindcss/postcss": "4.2.1",
    "tailwindcss": "4.2.1",
    "@types/pg": "^8.15.5"
  }
}
