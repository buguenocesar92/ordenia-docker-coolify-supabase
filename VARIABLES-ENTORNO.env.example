# Dominio web; sin barra al final
APP_URL=https://ordenia.tudominio.cl
# Supabase Connect: Project URL y publishable key (o anon legacy)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_PUBLISHABLE_KEY=REEMPLAZAR_CLAVE_PUBLICA
# Supabase Connect > Session pooler. URL-encode la contraseña.
DATABASE_URL=postgresql://postgres.TU-PROYECTO:REEMPLAZAR_PASSWORD@TU-HOST-POOLER:5432/postgres
DATABASE_SSL=true
TZ=America/Santiago
# Generar secreto propio: openssl rand -hex 32; mismo valor app y gateway
N8N_INGEST_TOKEN=REEMPLAZAR_SECRETO_ALEATORIO
WHATSAPP_ASSISTANT_NUMBER=
# Opcional: webhook de clasificación n8n; Bearer token compartido
N8N_CLASSIFY_URL=
N8N_CLASSIFY_TOKEN=
# Opcional: bridge Bitwarden privado (requiere desplegarlo y autorizar usuarios)
BITWARDEN_BRIDGE_URL=
BITWARDEN_BRIDGE_TOKEN=
# Solo receptor WhatsApp: completar cuando Meta esté listo
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_VERSION=v25.0
# Opcional: webhook n8n recibe multipart file y responde {"text":"..."}
AUDIO_TRANSCRIBE_URL=
AUDIO_TRANSCRIBE_TOKEN=

# Límites de tasa en memoria por proceso (opcionales; no escalan a varias réplicas)
# RATE_LIMIT_INGEST_MAX=120
# RATE_LIMIT_INGEST_WINDOW_SECONDS=60
# RATE_LIMIT_CLASSIFY_MAX=20
# RATE_LIMIT_CLASSIFY_WINDOW_SECONDS=60
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
